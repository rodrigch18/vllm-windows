diff --git a/deep_gemm/include/deep_gemm/common/exception.cuh b/deep_gemm/include/deep_gemm/common/exception.cuh
index 78acf74..c02d864 100644
--- a/deep_gemm/include/deep_gemm/common/exception.cuh
+++ b/deep_gemm/include/deep_gemm/common/exception.cuh
@@ -12,12 +12,26 @@ CUTLASS_HOST_DEVICE void host_device_printf(const char* format, ...) {
 #define printf host_device_printf
 #endif
 
+#ifndef DG_DEVICE_TRAP
+// `asm("trap;")` is not accepted by MSVC in host compilation; on Windows
+// device code uses the CUDA `__trap()` intrinsic instead.
+#ifdef _WIN32
+#ifdef __CUDACC__
+#define DG_DEVICE_TRAP() __trap()
+#else
+#define DG_DEVICE_TRAP() (void)0
+#endif
+#else
+#define DG_DEVICE_TRAP() asm("trap;")
+#endif
+#endif
+
 #ifndef DG_DEVICE_ASSERT
 #define DG_DEVICE_ASSERT(cond) \
 do { \
     if (not (cond)) { \
         printf("Assertion failed: %s:%d, condition: %s\n", __FILE__, __LINE__, #cond); \
-        asm("trap;"); \
+        DG_DEVICE_TRAP(); \
     } \
 } while (0)
 #endif
@@ -26,7 +40,7 @@ do { \
 #define DG_TRAP_ONLY_DEVICE_ASSERT(cond) \
 do { \
     if (not (cond)) \
-        asm("trap;"); \
+        DG_DEVICE_TRAP(); \
 } while (0)
 #endif
 
